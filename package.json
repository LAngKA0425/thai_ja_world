{
  "name": "taeja-world",
  "version": "0.0.0",
  "private": true,
  "description": "태자월드 모노레포 루트",
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "concurrently -k -n web,socket,api \"pnpm --dir apps/web dev\" \"pnpm --dir apps/socket-server dev\" \"python -m uvicorn src.main:app --app-dir app/backend --reload --port 8000\"",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d postgres redis",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "prod:up": "docker compose up -d --build",
    "prod:down": "docker compose down",
    "build": "turbo run build",

    "newsbot": "cd newsbot && node scripts/run-pipeline.js",
    "newsbot:collect": "cd newsbot && node collector/collect.js",
    "newsbot:process": "cd newsbot && node processor/process.js",
    "newsbot:summarize": "cd newsbot && node summarizer/summarize.js",
    "newsbot:weather": "cd newsbot && node collector/weather.js",
    "newsbot:exchange": "cd newsbot && node collector/exchange.js",
    "newsbot:daily": "cd newsbot && node collector/weather.js && node collector/exchange.js",
    "newsbot:admin": "cd newsbot && node admin/server.js",
    "newsbot:setup": "cd newsbot && node scripts/setup.js",

    "radarbot": "cd radarbot && node scripts/run-pipeline.js",
    "radarbot:collect": "cd radarbot && node collector/collect.js",
    "radarbot:classify": "cd radarbot && node classifier/classify.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.8.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0"
}