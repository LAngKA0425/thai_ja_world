# ============================================
# apps/web 환경변수 예시
# ============================================
# Next.js는 apps/web/.env(.local/.production)을 우선 로드합니다.
# 루트 .env 값은 자동으로 주입되지 않으므로, 서버 API route에서 필요한 값은 여기에 명시하세요.

# ---- 사이트 URL ----
# 서버(API route / 이메일 링크) 기준 URL
SITE_URL=http://localhost:3000
# 클라이언트 노출용 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Backend 내부 호출 (Next API route -> FastAPI) ----
BACKEND_INTERNAL_URL=http://localhost:8000
# FastAPI SECRET_KEY 와 동일 값
BACKEND_INTERNAL_SECRET=super-secret-change-me-in-production

# ---- JWT ----
JWT_SECRET=dev-secret-key-change-in-production

# ---- SMTP (비워두면 dev mode: 콘솔 출력) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taeja.world

# ---- Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- 기타 ----
NODE_ENV=development
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
