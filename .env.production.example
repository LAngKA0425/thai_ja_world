# ============================================
# TAEJA PRODUCTION ENV TEMPLATE
# ============================================
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# cp .env.production.example .env
# ============================================

# ── Database ──
POSTGRES_USER=taeja
POSTGRES_PASSWORD=여기에_강력한_비밀번호_입력
POSTGRES_DB=taeja
DATABASE_URL=postgresql+asyncpg://taeja:여기에_강력한_비밀번호_입력@postgres:5432/taeja
SYNC_DATABASE_URL=postgresql://taeja:여기에_강력한_비밀번호_입력@postgres:5432/taeja

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT (반드시 변경!) ──
SECRET_KEY=여기에_최소_32자_랜덤_문자열_입력
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anti-Abuse / Verification (확장 포인트) ──
SIGNUP_RISK_DEFAULT=low
SIGNUP_RISK_SCORE_THRESHOLD=70
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
EMAIL_VERIFICATION_PROVIDER=
SMS_VERIFICATION_PROVIDER=
PASSKEY_RP_ID=yourdomain.com
PASSKEY_RP_ORIGIN=https://yourdomain.com

# ── App ──
APP_ENV=production
DEBUG=false
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]

# ── Admin (첫 관리자 계정 - 서버 최초 실행 시 자동 생성) ──
FIRST_ADMIN_EMAIL=형이메일@실제주소.com
FIRST_ADMIN_PASSWORD=여기에_강력한_비밀번호_입력

# ── Community ──
OPEN_KAKAO_URL=https://open.kakao.com/o/실제_오픈채팅_링크

# ── Frontend (Next.js) ──
SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_OPEN_KAKAO_URL=https://open.kakao.com/o/실제_오픈채팅_링크
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com
# Next API route -> FastAPI 내부 호출용 (docker network 기준)
BACKEND_INTERNAL_URL=http://backend:8000
# FastAPI SECRET_KEY 와 동일 값
BACKEND_INTERNAL_SECRET=여기에_SECRET_KEY와_동일한_값_입력

# ── apps/web JWT (반드시 변경!) ──
JWT_SECRET=여기에_최소_32자_랜덤_문자열_입력

# ── apps/socket-server ──
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=https://yourdomain.com

# ── WebAuthn / Passkey (현재 미구현 - 추후 사용) ──
# WEBAUTHN_RP_ID=yourdomain.com
# WEBAUTHN_RP_NAME=태자
# WEBAUTHN_ORIGIN=https://yourdomain.com

# ── SMTP (이메일 인증 발송) ──
# SMTP_HOST 설정 시 실제 이메일 발송, 미설정 시 콘솔 출력 (dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=여기에_SMTP_계정_입력
SMTP_PASS=여기에_SMTP_비밀번호_입력
SMTP_FROM="태국에 살자" <noreply@taeja.world>

# ── Cloudflare Turnstile (필수) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=여기에_Turnstile_Site_Key_입력
TURNSTILE_SECRET_KEY=여기에_Turnstile_Secret_Key_입력

# ── Push / Firebase (현재 미구현 - 추후 사용) ──
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
