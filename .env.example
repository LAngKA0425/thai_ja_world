# ============================================
# 태자월드 환경변수 설정 (.env.example)
# ============================================
# 이 파일을 .env로 복사한 후 실값을 입력하세요.
# cp .env.example .env
# ============================================
# HOST 규칙:
#   local dev (pnpm dev)  → localhost
#   docker dev/prod       → docker-compose.*.yml 의 environment 섹션이 덮어씀
#                           (postgres, redis 등 서비스명 사용)
# 따라서 이 파일은 local dev 기준으로 localhost 를 기본값으로 둡니다.
# ============================================

# ---- Database ----
POSTGRES_USER=taeja
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taeja
# local dev: localhost / docker: docker-compose environment 가 postgres 로 덮어씀
DATABASE_URL=postgresql+asyncpg://taeja:changeme@localhost:5432/taeja
SYNC_DATABASE_URL=postgresql://taeja:changeme@localhost:5432/taeja

# ---- Redis ----
# local dev: localhost / docker: docker-compose environment 가 redis 로 덮어씀
REDIS_URL=redis://localhost:6379/0

# ---- JWT / Auth ----
SECRET_KEY=super-secret-change-me-in-production
# Admin CMS 전용 JWT 시크릿 (public SECRET_KEY 와 반드시 다르게 설정)
ADMIN_JWT_SECRET=admin-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Anti-Abuse / Verification (확장 포인트) ----
SIGNUP_RISK_DEFAULT=low
SIGNUP_RISK_SCORE_THRESHOLD=70
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
EMAIL_VERIFICATION_PROVIDER=
SMS_VERIFICATION_PROVIDER=
PASSKEY_RP_ID=
PASSKEY_RP_ORIGIN=

# ---- Cloudflare Turnstile (Frontend CAPTCHA) ----
# https://developers.cloudflare.com/turnstile/get-started/
# 비워두거나 'dev-skip'으로 설정하면 개발 모드에서 검증 스킵
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- App ----
APP_ENV=development
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# ---- Admin (첫 관리자 계정) ----
FIRST_ADMIN_EMAIL=admin@taeja.local
FIRST_ADMIN_PASSWORD=admin1234

# ---- Community ----
OPEN_KAKAO_URL=https://open.kakao.com/o/your-chat-link

# ---- Frontend (Next.js) ----
# SITE_URL: 서버 사이드 전용 (API route, email 등)
# NEXT_PUBLIC_SITE_URL: 클라이언트 사이드 노출용
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Next API route -> FastAPI 내부 호출용
BACKEND_INTERNAL_URL=http://localhost:8000
# FastAPI SECRET_KEY 와 동일 값 사용
BACKEND_INTERNAL_SECRET=super-secret-change-me-in-production
NEXT_PUBLIC_OPEN_KAKAO_URL=https://open.kakao.com/o/your-chat-link
# NEXT_PUBLIC_API_URL=http://localhost/api

# ---- apps/web JWT (필수) ----
JWT_SECRET=dev-secret-key-change-in-production

# ---- apps/web 추가 설정 ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-nextauth-secret
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ---- apps/socket-server ----
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=http://localhost:3000

# ---- OAuth (향후 연결) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# ---- 결제 (향후 연결) ----
# TOSS_PAYMENTS_CLIENT_KEY=
# TOSS_PAYMENTS_SECRET_KEY=

# ---- 파일 스토리지 (향후 연결) ----
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- 이메일/알림 ----
# SMTP 설정 시 실제 이메일 발송, 미설정 시 콘솔 출력 (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taeja.world

# ---- 환경 ----
NODE_ENV=development

# ============================================
# Supabase (봇 + 웹 공통)
# newsbot / radarbot 이 직접 읽는 변수
# ============================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# 클라이언트 노출용 (anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Ollama 2단계 모델 전략
# Stage 1 (번역): 정확성 우선
#   권장: llama3.1:8b (균형) / qwen2.5:7b (아시아어 강점)
# Stage 2 (카피/요약): 창의성 허용
#   권장: gemma2:9b (카피 품질) 또는 Stage 1 모델과 동일
# 단일 모델 운영 시 OLLAMA_COPY_MODEL 제거 또는 동일값 사용
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TRANSLATE_MODEL=llama3.1:8b
OLLAMA_COPY_MODEL=llama3.1:8b
# 타임아웃 (ms). 모델 크기에 따라 늘릴 것 (8b=60000, 13b=120000)
OLLAMA_TIMEOUT_MS=60000
# 기사 간 딜레이 (ms). Ollama 부하 방지
OLLAMA_STEP_DELAY_MS=1500

# ============================================
# 뉴스봇 설정
# newsbot/.env 또는 루트 .env 에서 로드
# ============================================
# 수집기 설정
MAX_ARTICLES_PER_SOURCE=10
# 관리자 서버 포트 (localhost:3099 - 이전 임시 구조 유지 중)
# 최종 목표: apps/web admin으로 통합 완료 후 제거
ADMIN_PORT=3099
# 관리자 공통 비밀번호 (web admin + newsbot admin 공유)
ADMIN_PASSWORD=changeme-in-production
# newsbot 파이프라인 루트 (apps/web 에서 수동 트리거 시 사용)
NEWSBOT_ROOT_PATH=/app/newsbot

# ============================================
# 레이더봇 설정
# radarbot/.env 또는 루트 .env 에서 로드
# ============================================
RADARBOT_ROOT_PATH=/app/radarbot

# ============================================
# 봇 운영 보안
# OPS_SHARED_SECRET: 내부 수동 트리거 API 인증
#   - 미설정 시 /api/admin/news/pipeline 이 외부 shared secret 경로 차단(fail-closed)
#   - 관리자 Bearer 토큰으로는 항상 접근 가능
# ============================================
OPS_SHARED_SECRET=change-this-ops-secret-in-production

# ============================================
# 소셜 링크 (뉴스봇 게시 푸터에 삽입)
# ============================================
KAKAO_OPEN_URL=https://open.kakao.com/o/your-chat-link
TELEGRAM_URL=https://t.me/your-channel
LINE_URL=https://line.me/ti/g/your-group

# ============================================
# 도메인 연결 전 (production 배포 직전) 반드시 변경할 항목
# ============================================
# production 에서 아래 값을 실제 도메인으로 교체:
# SITE_URL=https://thaijaworld.com
# NEXT_PUBLIC_SITE_URL=https://thaijaworld.com
# BACKEND_CORS_ORIGINS=["https://thaijaworld.com","https://admin.thaijaworld.com"]
# NEXTAUTH_URL=https://thaijaworld.com
# NEXT_PUBLIC_SOCKET_URL=https://socket.thaijaworld.com
# SMTP_FROM=noreply@thaijaworld.com
